{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-Debug_ogl",
      "hidden": false,
      "description": "Debug configuration with OpenGL API",
      "binaryDir": "${sourceDir}/out/x64-Debug_ogl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_OPENGL_API": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows",
        "PETFORDESKTOP_USE_FETCHCONTENT_DEPS": "OFF"
      }
    },
    {
      "name": "x64-Release_ogl",
      "hidden": false,
      "description": "Release configuration with OpenGL API",
      "binaryDir": "${sourceDir}/out/x64-Release_ogl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_OPENGL_API": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows",
        "PETFORDESKTOP_USE_FETCHCONTENT_DEPS": "OFF"
      }
    },
    {
      "name": "ci-release",
      "hidden": false,
      "description": "Single-config release preset for CI, install staging, and packaging",
      "binaryDir": "${sourceDir}/out/ci-release-modern",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_OPENGL_API": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows",
        "PETFORDESKTOP_USE_FETCHCONTENT_DEPS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-Debug_ogl",
      "configurePreset": "x64-Debug_ogl",
      "configuration": "Debug"
    },
    {
      "name": "x64-Release_ogl",
      "configurePreset": "x64-Release_ogl",
      "configuration": "Release"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-Debug_ogl",
      "configurePreset": "x64-Debug_ogl",
      "configuration": "Debug"
    },
    {
      "name": "x64-Release_ogl",
      "configurePreset": "x64-Release_ogl",
      "configuration": "Release"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "configuration": "Release"
    }
  ]
}
